# Copy to `.env` and fill with real values (see Phase 3a brief). `infra/.env` is gitignored.
# Used by: docker compose -f docker-compose.yml from this directory.
#
# v0 prototyping environment — superseded by GCP architecture
# See ADR-016 in DECISIONS.md for the architectural pivot rationale.
# These containers remain running on the Hostinger VPS as a fallback
# environment but are not the demo path.
#
# Names like `postgres_binalyze`, `binalyze_audit`, `nocodb_binalyze` are internal Docker/Postgres
# identifiers (legacy v0), not public third-party company branding.

# --- Postgres (postgres_binalyze / pgvector) ---
# Database superuser name created on first init.
POSTGRES_USER=CHANGE_ME_DB_USER
# Database user password (32 hex chars recommended; URL-safe if NocoDB NC_DB uses it in query string).
POSTGRES_PASSWORD=CHANGE_ME_32_CHAR_PASSWORD
# Initial database name (NocoDB app DB). A second DB `binalyze_audit` is created on first init via postgres/init-databases.sql.
POSTGRES_DB=CHANGE_ME_DB_NAME

# --- Qdrant (qdrant_binalyze) ---
# API key for Qdrant HTTP/gRPC (Qdrant env convention uses double underscores).
QDRANT__SERVICE__API_KEY=CHANGE_ME_32_CHAR_API_KEY

# --- NocoDB (nocodb_binalyze) ---
# PostgreSQL connection for NocoDB. Host must be the Docker service name `postgres_binalyze` (DNS on app-net).
# Format: pg://HOST:5432?u=POSTGRES_USER&p=POSTGRES_PASSWORD&d=POSTGRES_DB (keep user/password/db aligned with Postgres vars above).
NC_DB=pg://postgres_binalyze:5432?u=CHANGE_ME_DB_USER&p=CHANGE_ME_32_CHAR_PASSWORD&d=CHANGE_ME_DB_NAME
# JWT secret for NocoDB auth (64 hex chars recommended).
NC_AUTH_JWT_SECRET=CHANGE_ME_64_HEX_JWT_SECRET

# --- Traefik hostnames (must match DNS + Traefik ACME; same VPS pattern as n8n) ---
# Apex domain used in STS SSLHost middleware (same role as DOMAIN_NAME in /root/docker-compose.yml for n8n).
DOMAIN_NAME=srv1178070.hstgr.cloud
# Public HTTPS host for NocoDB (router Host() rule).
NOCO_HOST=nocodb.srv1178070.hstgr.cloud
# Public HTTPS host for Grafana (router Host() rule).
GRAFANA_HOST=grafana.srv1178070.hstgr.cloud

# --- Grafana (grafana_binalyze) ---
# GF_SERVER_ROOT_URL is set in docker-compose.yml to https://${GRAFANA_HOST} (required behind Traefik).
GF_SECURITY_ADMIN_USER=CHANGE_ME_ADMIN_USER
# Grafana admin password (24+ chars recommended).
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
